# Copy this file to .env and fill in your values
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: use a different OpenAI-compatible base URL (e.g. for local models via LM Studio / Ollama)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Model to use for generating learning plans (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Enable Flask debug mode for local development only (never set to true in production)
# FLASK_DEBUG=true

# Port to run the local Flask server on (default: 5000)
# PORT=5000
